# ── Database (Neon serverless Postgres) ─────────────────────────
# Pooled connection used at runtime by the app
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (non-pooled) connection used by migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth.js (NextAuth v5) ───────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="FutureMinds <no-reply@futureminds.ro>"

# ── File storage (S3-compatible, e.g. Cloudflare R2) ────────────
# Private bucket — documents are served only through authenticated admin routes
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_ENDPOINT=""

# Public base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
